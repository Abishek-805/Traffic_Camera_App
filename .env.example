# Smart Traffic Management System - Traffic Camera Node Configuration

# Backend Host Server (IP address or Domain Name)
# NOTE for Mobile Testing:
# - '127.0.0.1' or 'localhost' points to the mobile device itself when running on a phone/emulator.
# - Specify your backend server's LAN IP (e.g. 192.168.1.100) or domain for network streaming.
EXPO_PUBLIC_SERVER_HOST=YOUR_BACKEND_IP_OR_DOMAIN

# REST API Port
EXPO_PUBLIC_REST_PORT=8000

# WebSocket Live Stream Port
EXPO_PUBLIC_WEBSOCKET_PORT=8001
