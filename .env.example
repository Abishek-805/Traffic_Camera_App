# Traffic Camera Node - Environment Configuration (.env)
# Copy this file to .env before starting development or building.

# Backend Host (IP address or Domain Name)
# NOTE:
# - '127.0.0.1' or 'localhost' refers to the mobile device itself when running on Android.
# - Specify your laptop/server LAN IP address (e.g., 192.168.1.100) or domain.
# - When pairing via QR code, the host and port are extracted directly from the QR payload.
EXPO_PUBLIC_SERVER_HOST=192.168.1.100

# Backend REST API Port
# Default: 8000 (both combined and split server architectures use 8000 for REST)
EXPO_PUBLIC_REST_PORT=8000

# Backend Camera WebSocket Port
# Combined Server (default): 8000
# Split/Docker Server: 8001
EXPO_PUBLIC_WEBSOCKET_PORT=8000
