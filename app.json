{
  "expo": {
    "name": "Traffic Camera Node",
    "slug": "traffic-camera-node",
    "version": "1.0.8",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Traffic Camera Node requires camera access to stream live video feeds to the Smart Traffic Management System server."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.BATTERY_STATS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.smile_505.trafficcameranode",
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Traffic Camera Node requires camera access to scan QR codes and capture video for traffic management.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withTrustedLan"
    ],
    "extra": {
      "eas": {
        "projectId": "7590fd21-ece9-4e95-af1b-b47be5b1d7e9"
      }
    }
  }
}
